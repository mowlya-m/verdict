# Required by the intake and vision agents. Nothing else in the system
# calls a model — the decision engine itself makes no model calls at all.
ANTHROPIC_API_KEY=

VERDICT_API_URL=http://localhost:8000
AUTO_SETTLE_CEILING=5000

# Not a local env var — this is a GitHub Actions secret, set at
# github.com/mowlya-m/verdict/settings/secrets/actions, used by the
# Deploy workflow to push the API to Fly on every push to main.
# Generate with: flyctl tokens create deploy -a verdict-api-shy-lagoon-5002
# FLY_API_TOKEN is configured in GitHub, not here.
