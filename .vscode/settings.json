{
  "python.defaultInterpreterPath": "/opt/anaconda3/bin/python3.12",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["apps/api/tests"],
  "python.analysis.extraPaths": ["apps/api/src", "."],
  "terminal.integrated.env.osx": { "PYTHONPATH": "apps/api/src:." },
  "terminal.integrated.env.linux": { "PYTHONPATH": "apps/api/src:." },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true
  },
  "editor.formatOnSave": true,
  "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" }
}
